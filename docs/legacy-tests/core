	}
}

func TestParseCustomRows(t *testing.T) {
	// 测试辅助函数
	testCases := []struct {
		input    string
		expected []int
	}{
		{"1,3,5", []int{1, 3, 5}},
		{"1-3", []int{1, 2, 3}},
		{"1,3-5,7", []int{1, 3, 4, 5, 7}},
		{"1,1,2,2", []int{1, 2}}, // 去重测试
	}
	
	for _, tc := range testCases {
		// 这里直接测试私有函数的逻辑
		result := parseTestRows(tc.input)
		if len(result) != len(tc.expected) {
			t.Errorf("parseCustomRows(%s) length = %d; expected %d", 
				tc.input, len(result), len(tc.expected))
			continue
		}
		
		for i, val := range result {
			if val != tc.expected[i] {
				t.Errorf("parseCustomRows(%s)[%d] = %d; expected %d", 
					tc.input, i, val, tc.expected[i])
			}
		}
	}
}

// 辅助测试函数
func parseTestRows(rowStr string) []int {
	var rows []int
	parts := strings.Split(strings.ReplaceAll(rowStr, " ", ""), ",")
	
	for _, part := range parts {
		if strings.Contains(part, "-") {
			rangeParts := strings.Split(part, "-")
			if len(rangeParts) == 2 {
				var start, end int
				fmt.Sscanf(rangeParts[0], "%d", &start)
				fmt.Sscanf(rangeParts[1], "%d", &end)
				for i := start; i <= end; i++ {
					rows = append(rows, i)
				}
			}
		} else {
			var rowNum int
			fmt.Sscanf(part, "%d", &rowNum)
			rows = append(rows, rowNum)
		}
	}
	
	// 去重并排序
	sort.Ints(rows)
	uniqueRows := make([]int, 0, len(rows))
	prev := 0
	for _, row := range rows {
		if row != prev {
			uniqueRows = append(uniqueRows, row)
			prev = row
		}
	}
	
	return uniqueRows
}