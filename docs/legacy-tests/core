func TestNewExcelProcessor(t *testing.T) {
	ep := NewExcelProcessor()
	if ep == nil {
		t.Error("NewExcelProcessor() should not return nil")
	}
	
	if ep.files == nil {
		t.Error("ExcelProcessor.files should be initialized")
	}
	
	if len(ep.files) != 0 {
		t.Error("ExcelProcessor.files should be empty initially")
	}
}

func TestDeleteConfigValidation(t *testing.T) {
	config := DeleteConfig{
		DeleteFirstRows: 5,
		DeleteLastRows:  3,
		CustomRows:      "10-15",
		DeleteFirstCols: 2,
		DeleteLastCols:  1,
		CustomCols:      "D-F",
		SheetName:       "Sheet1",
	}
	
	// 验证配置结构
	if config.DeleteFirstRows != 5 {
		t.Errorf("DeleteFirstRows = %d; expected 5", config.DeleteFirstRows)
	}
	
	if config.DeleteLastRows != 3 {
		t.Errorf("DeleteLastRows = %d; expected 3", config.DeleteLastRows)
	}
	
	if config.CustomRows != "10-15" {
		t.Errorf("CustomRows = %s; expected '10-15'", config.CustomRows)
	}
	
	if config.DeleteFirstCols != 2 {
		t.Errorf("DeleteFirstCols = %d; expected 2", config.DeleteFirstCols)
	}
	
	if config.DeleteLastCols != 1 {
		t.Errorf("DeleteLastCols = %d; expected 1", config.DeleteLastCols)
	}
	
	if config.CustomCols != "D-F" {
		t.Errorf("CustomCols = %s; expected 'D-F'", config.CustomCols)
	}
	
	if config.SheetName != "Sheet1" {
		t.Errorf("SheetName = %s; expected 'Sheet1'", config.SheetName)
	}
}

