func TestNewHandler(t *testing.T) {
	handler := NewHandler()
	if handler == nil {
		t.Error("NewHandler() should not return nil")
	}
	
	if handler.file != nil {
		t.Error("NewHandler() should initialize with nil file")
	}
	
	if handler.path != "" {
		t.Error("NewHandler() should initialize with empty path")
	}
}

func TestParseRowRange(t *testing.T) {
	tests := []struct {
		input    string
		maxRows  int
		expected []int
	}{
		{"1", 10, []int{1}},
		{"1,3,5", 10, []int{1, 3, 5}},
		{"1-3", 10, []int{1, 2, 3}},
		{"1,3-5,7", 10, []int{1, 3, 4, 5, 7}},
		{"1,1,2,2", 10, []int{1, 2}}, // 去重测试
		{"15", 10, []int{}},          // 超出范围
		{"5-15", 10, []int{5, 6, 7, 8, 9, 10}}, // 部分超出范围
	}
	
	for _, test := range tests {
		result := ParseRowRange(test.input, test.maxRows)
		if len(result) != len(test.expected) {
			t.Errorf("ParseRowRange(%s, %d) length = %d; expected %d", 
				test.input, test.maxRows, len(result), len(test.expected))
			continue
		}
		
		for i, val := range result {
			if val != test.expected[i] {
				t.Errorf("ParseRowRange(%s, %d)[%d] = %d; expected %d", 
					test.input, test.maxRows, i, val, test.expected[i])
			}
		}
	}
}

