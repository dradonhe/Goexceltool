}

func TestValidateSheetName(t *testing.T) {
	validNames := []string{
		"Sheet1",
		"Data",
		"My Sheet",
		"报表数据",
	}
	
	invalidNames := []string{
		"",                    // 空名称
		"VeryLongSheetNameThatExceedsThirtyOneCharactersLimit", // 超过31字符
		"Sheet[1]",           // 包含非法字符
		"Sheet/2",            // 包含斜杠
		"Sheet*",             // 包含星号
	}
	
	for _, name := range validNames {
		if !ValidateSheetName(name) {
			t.Errorf("ValidateSheetName(%s) should return true", name)
		}
	}
	
	for _, name := range invalidNames {
		if ValidateSheetName(name) {
			t.Errorf("ValidateSheetName(%s) should return false", name)
		}
	}
}

func TestColToNum(t *testing.T) {
	tests := []struct {
		input    string
		expected int
	}{
		{"A", 1},
		{"B", 2},
		{"Z", 26},
		{"AA", 27},
		{"AB", 28},
		{"AZ", 52},
		{"BA", 53},
		{"ZZ", 702},
		{"AAA", 703},
	}
	
	for _, test := range tests {
		result := colToNum(test.input)
		if result != test.expected {
			t.Errorf("colToNum(%s) = %d; expected %d", test.input, result, test.expected)
		}
	}
}